<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F5F5"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💖 心率监听设置"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FF2D2D2D"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_ble_direct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="直接连接 BLE 设备 (无需第三方App)"
            android:textSize="16sp"
            android:textColor="#FF333333"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="手环/手表蓝牙 MAC 地址 (留空则自动连接附近心率设备)"
            android:textSize="14sp"
            android:textColor="#FF666666"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_ble_mac"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="例如: 00:11:22:33:44:55"
            android:inputType="text"
            android:textSize="15sp"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="24dp" />

        <!-- 心率服务端地址 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="心率接收服务端地址"
            android:textSize="14sp"
            android:textColor="#FF666666"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_heartrate_server"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="http://你的公网IP:3476"
            android:inputType="textUri"
            android:textSize="15sp"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 提示：开启直接连接后，App将在前台扫描并连接心率设备。如果未开启，将回退到拦截 Notify for Mi Band 等第三方软件的广播。"
            android:textSize="12sp"
            android:textColor="#FF999999"
            android:layout_marginBottom="32dp" />

        <!-- 保存按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_heartrate_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="💾 保存设置并重启服务"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>
